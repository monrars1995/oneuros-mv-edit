{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "version": "2.0.0",
  "description": "Especificações técnicas, dimensões e zonas seguras oficiais por plataforma e formato de entrega.",
  "platforms": {
    "instagram_reels": {
      "name": "Instagram Reels",
      "aspect_ratio": "9:16",
      "width": 1080,
      "height": 1920,
      "fps": 30,
      "safe_zones": {
        "top_margin_px": 250,
        "bottom_margin_px": 385,
        "left_margin_px": 70,
        "right_margin_high_px": 55,
        "right_margin_low_px": 193,
        "right_margin_split_y": 1110,
        "description": "Topo ocupado por câmera/Reels header; base ocupada por legenda do post, áudio e botão Seguir; lateral direita baixa ocupada por ícones de curtir, comentar e compartilhar."
      },
      "graphics_usable_box": {
        "x_min": 70,
        "x_max": 1025,
        "y_min": 250,
        "y_max_anchor": "above_head_minus_60px"
      },
      "subtitles_box": {
        "x_min": 70,
        "x_max": 887,
        "center_x": 478,
        "y_min": 1150,
        "y_max": 1480,
        "anchor_y": 1300,
